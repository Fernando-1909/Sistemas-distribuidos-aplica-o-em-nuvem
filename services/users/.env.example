# Copie para .env e ajuste (o .env NAO deve ir para o Git).
# Sem DATABASE_URL, o modo DEBUG usa SQLite local para facilitar o desenvolvimento.
DEBUG=True
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8000

# PostgreSQL (Neon) deste servico - formato: postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
DATABASE_URL=
